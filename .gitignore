# Ignore node_modules directory (where npm installs dependencies)
node_modules/

# Ignore build output (e.g., if you're using TypeScript or Babel)
dist/
build/
out/
public/build/

# Ignore log files
*.log
logs/
debug.log
npm-debug.log*

# Ignore temporary files
tmp/
temp/
*.tmp
*.swp
*.swo
.DS_Store
Thumbs.db

# Ignore environment files
.env
.env.*
!.env.example

# Ignore IDE / Editor files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swc
